{
  "schema_version": "3.2",
  "global": {
    "runtime_authority": "workspace/active/<asset>/mcp/state.json",
    "governance": "engines/shared/workflow/GOVERNANCE.md",
    "state_contract": "engines/shared/workflow/STATE_MACHINE.md",
    "evidence_contract": "engines/shared/workflow/EVIDENCE_CONTRACT.md",
    "checkpoint_contract": "engines/shared/workflow/CHECKPOINT_RECOVERY.md",
    "tool_profile_contract": "engines/shared/profiles/tool-profiles.json",
    "skill_profile_contract": "engines/shared/skills/skill-profiles.json",
    "max_loaded_production_skills": 2,
    "geometry_profile_policy": "single_profile_one_session",
    "profile_transition_policy": "stage_transition_only",
    "accepted_area_policy": "immutable_unless_explicitly_reopened",
    "visual_feedback_budget": {
      "reference_inspections": 1,
      "targeted_diagnostic_checks": 3,
      "final_review_checks": 1
    },
    "image_transport_policy": {
      "reference_source_authority_preserved": true,
      "runtime_preview_only": true,
      "default_format": "jpeg",
      "default_max_dimension": 1400,
      "default_max_transport_bytes": 786432,
      "original_binary_in_tool_response_forbidden": true
    }
  },
  "camera": {
    "front_axis_default": "-z",
    "orthographic_views": ["front", "left_side", "back", "top_footprint"],
    "perspective_views": ["front_left_3_4"],
    "views": ["front", "left_side", "back", "top_footprint", "front_left_3_4"],
    "frame_margin_ratio": 1.25,
    "clean_capture": true,
    "world_bounds_required": true,
    "fixed_approved_envelope_for_diagnosis": true
  },
  "geometry_visual_policy": {
    "reference_tool": "inspect_reference_visual_preview",
    "feedback_tool": "capture_visual_feedback",
    "diagnosis_tool": "analyze_geometry_views",
    "record_tool": "record_geometry_visual_decision",
    "gate_tool": "verify_geometry_review_ready",
    "review_submission_tool": "submit_geometry_for_review",
    "structural_pass_is_visual_pass": false,
    "multimodal_review_required": true,
    "diagnostic_guard_required": true,
    "fixed_scale_required": true,
    "free_rescale_forbidden": true,
    "required_final_visual_result": "PASS",
    "targeted_views": ["left_side", "front", "top_footprint"],
    "final_views": ["front", "left_side", "back", "top_footprint", "front_left_3_4"]
  },
  "geometry_rotation_policy": {
    "placement_tool": "place_cubes_safe",
    "modification_tool": "modify_cubes",
    "contract_rotation_tool": "rotate_cube_about_attachment",
    "preferred_axes_per_cube": 1,
    "maximum_axes_per_cube": 1,
    "maximum_absolute_degrees": 45,
    "explicit_attachment_contract_required": true,
    "explicit_origin_required_when_rotating": true,
    "pivot_margin_ratio": 1,
    "direction_validation_required": true,
    "connection_validation_required_when_declared": true,
    "before_after_visual_score_required": true,
    "automatic_visual_regression_rollback": true,
    "reject_stale_visual_report_after_rotation": true
  },
  "profiles": {
    "GEOMETRY": {
      "tool_profile_id": "BEDROCK_CUBOID_GEOMETRY",
      "skill_profile_id": "GEOMETRY",
      "working_state": "GEOMETRY_IN_PROGRESS",
      "review_state": "GEOMETRY_REVIEW",
      "approved_state": "GEOMETRY_APPROVED",
      "identity_sync_tool": "rebind_active_project_identity",
      "revision_prepare_tool": "prepare_geometry_visual_rebuild",
      "revision_scope": {
        "values": ["LOCAL_REPAIR", "MAJOR_FORM_REVISION"],
        "role": "internal_codex_decision",
        "requires_profile_switch": false,
        "requires_reconnect": false,
        "review_state_returns_to_working_state": true
      },
      "internal_progress_markers": ["PRIMARY_FORM", "STRUCTURAL_DETAIL", "FINAL_REVIEW_READY"],
      "internal_progress_markers_are_user_gates": false,
      "compact_context_tool": "get_stage_context",
      "reference_preview_tool": "inspect_reference_visual_preview",
      "compact_validation_tool": "validate_geometry_contract",
      "diagnostic_visual_tool": "analyze_geometry_views",
      "visual_decision_tool": "record_geometry_visual_decision",
      "safe_rotation_tool": "rotate_cube_about_attachment",
      "review_readiness_tool": "verify_geometry_review_ready",
      "review_submission_tool": "submit_geometry_for_review",
      "approval_transition_tool": "complete_geometry_stage",
      "review_checkpoint_policy": "next_unused_non_approved_geometry_checkpoint",
      "approved_checkpoint": "checkpoints/20_geometry_approved.bbmodel",
      "required_evidence": {
        "front": "evidence/geometry/geometry_front.png",
        "left_side": "evidence/geometry/geometry_left.png",
        "back": "evidence/geometry/geometry_back.png",
        "top_footprint": "evidence/geometry/geometry_top.png",
        "front_left_3_4": "evidence/geometry/geometry_front_left_3_4.png",
        "visual_metrics": "evidence/geometry/geometry_visual_metrics.json",
        "visual_diff": "evidence/geometry/geometry_visual_diff.png",
        "visual_report": "evidence/geometry/geometry_visual_report.json",
        "runtime": "evidence/geometry/geometry_runtime.json",
        "report": "evidence/geometry/geometry_report.json"
      }
    },
    "TEXTURE": {
      "tool_profile_id": "BEDROCK_CUBOID_TEXTURE",
      "repair_tool_profile_id": "TEXTURE_LOCAL_REPAIR",
      "skill_profile_id": "TEXTURE",
      "working_state": "TEXTURE_IN_PROGRESS",
      "review_state": "TEXTURE_REVIEW",
      "approved_state": "TEXTURE_APPROVED",
      "internal_passes": ["UV", "BASE_TEXTURE", "DETAIL_TEXTURE"],
      "compact_validation_tool": "validate_reference_contract",
      "atlas_evidence_tool": "save_texture_evidence",
      "approval_transition_tool": "complete_stage",
      "review_checkpoint": "checkpoints/30_texture_review.bbmodel",
      "approved_checkpoint": "checkpoints/40_texture_approved.bbmodel",
      "required_evidence": {
        "atlas": "evidence/texture/texture_atlas.png",
        "front": "evidence/texture/texture_front.png",
        "left_side": "evidence/texture/texture_left.png",
        "back": "evidence/texture/texture_back.png",
        "front_left_3_4": "evidence/texture/texture_front_left_3_4.png",
        "report": "evidence/texture/texture_report.json"
      }
    },
    "ANIMATION": {
      "tool_profile_id": "BEDROCK_CUBOID_ANIMATION",
      "repair_tool_profile_id": "ANIMATION_LOCAL_REPAIR",
      "skill_profile_id": "ANIMATION",
      "working_state": "ANIMATION_IN_PROGRESS",
      "review_state": "ANIMATION_REVIEW",
      "approved_state": "ANIMATION_APPROVED",
      "skipped_state": "ANIMATION_SKIPPED",
      "optional": true,
      "compact_validation_tool": "validate_reference_contract",
      "approval_transition_tool": "complete_stage",
      "review_checkpoint": "checkpoints/50_animation_review.bbmodel",
      "approved_checkpoint": "checkpoints/60_animation_approved.bbmodel",
      "skipped_checkpoint": "checkpoints/60_animation_skipped.bbmodel"
    },
    "FINAL_VALIDATION": {
      "tool_profile_id": "FINAL_VALIDATION_READONLY",
      "skill_profile_id": "FINAL_VALIDATION",
      "working_state": "FINAL_VALIDATION",
      "review_state": "FINAL_REVIEW",
      "approved_state": "DONE",
      "automatic_local_fix_limit": 2,
      "compact_validation_tool": "validate_reference_contract",
      "geometry_review_readiness_tool": "verify_geometry_review_ready",
      "atlas_evidence_tool": "save_texture_evidence",
      "approval_transition_tool": "complete_stage",
      "candidate_checkpoint": "checkpoints/70_final_candidate.bbmodel",
      "pass_checkpoint": "checkpoints/80_validation_pass.bbmodel"
    }
  }
}
