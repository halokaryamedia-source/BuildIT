{
  "schema_version": "1.3",
  "canonical_root": "engines/shared/skills",
  "host_adapters": [
    ".agents/skills",
    ".codex/skills"
  ],
  "max_production_skills_loaded": 2,
  "production_skills": [
    "blockbench-production",
    "blockbench-geometry",
    "blockbench-texture",
    "blockbench-animation",
    "blockbench-validation"
  ],
  "repository_development_skills": [
    "engineering-discipline",
    "code-review-graph"
  ],
  "profiles": {
    "BOOTSTRAP": {
      "required": ["blockbench-production"],
      "forbidden": [
        "blockbench-geometry",
        "blockbench-texture",
        "blockbench-animation",
        "blockbench-validation"
      ],
      "max_loaded": 1
    },
    "GEOMETRY": {
      "required": ["blockbench-production", "blockbench-geometry"],
      "forbidden": [
        "blockbench-texture",
        "blockbench-animation",
        "blockbench-validation",
        "mcp-builder"
      ],
      "max_loaded": 2
    },
    "TEXTURE": {
      "required": ["blockbench-production", "blockbench-texture"],
      "forbidden": [
        "blockbench-geometry",
        "blockbench-animation",
        "blockbench-validation",
        "mcp-builder"
      ],
      "max_loaded": 2
    },
    "ANIMATION": {
      "required": ["blockbench-production", "blockbench-animation"],
      "forbidden": [
        "blockbench-geometry",
        "blockbench-texture",
        "blockbench-validation",
        "mcp-builder"
      ],
      "max_loaded": 2
    },
    "FINAL_VALIDATION": {
      "required": ["blockbench-production", "blockbench-validation"],
      "forbidden": [
        "blockbench-geometry",
        "blockbench-texture",
        "blockbench-animation",
        "mcp-builder"
      ],
      "max_loaded": 2
    }
  },
  "state_map": {
    "REFERENCE_READY": "BOOTSTRAP",
    "GEOMETRY_IN_PROGRESS": "GEOMETRY",
    "GEOMETRY_REVIEW": "GEOMETRY",
    "GEOMETRY_REVISION": "GEOMETRY",
    "GEOMETRY_APPROVED": "TEXTURE",
    "TEXTURE_IN_PROGRESS": "TEXTURE",
    "TEXTURE_REVIEW": "TEXTURE",
    "TEXTURE_REVISION": "TEXTURE",
    "TEXTURE_APPROVED": "ANIMATION_OR_FINAL_VALIDATION",
    "ANIMATION_IN_PROGRESS": "ANIMATION",
    "ANIMATION_REVIEW": "ANIMATION",
    "ANIMATION_REVISION": "ANIMATION",
    "ANIMATION_APPROVED": "FINAL_VALIDATION",
    "ANIMATION_SKIPPED": "FINAL_VALIDATION",
    "FINAL_VALIDATION": "FINAL_VALIDATION",
    "FINAL_REVIEW": "FINAL_VALIDATION",
    "FINAL_REVISION": "FINAL_VALIDATION",
    "DONE": "FINAL_VALIDATION"
  },
  "conditional_profiles": {
    "ANIMATION_OR_FINAL_VALIDATION": {
      "condition": "workflow.animation_required",
      "when_true": "ANIMATION",
      "when_false": "FINAL_VALIDATION"
    }
  },
  "repository_development": {
    "foundation_change": "openspec/changes/buildit-system-foundation",
    "domain_ownership": {
      "requirements": [
        "explicit-user-instruction",
        "active-openspec-change"
      ],
      "scope_efficiency": [
        "ponytail"
      ],
      "engineering_method": [
        "engineering-discipline"
      ],
      "context_intelligence": [
        "code-review-graph",
        "current-source"
      ],
      "model_execution": [
        "capability-gate",
        "model-selector"
      ],
      "technical_evidence": [
        "current-source",
        "git-diff",
        "tests",
        "typecheck",
        "build",
        "runtime-evidence"
      ]
    },
    "task_router": {
      "REQUIREMENT_CHANGE": {
        "primary_domain": "requirements",
        "support_domains": ["scope_efficiency", "engineering_method"]
      },
      "FEATURE": {
        "primary_domain": "requirements",
        "support_domains": ["scope_efficiency", "engineering_method", "context_intelligence"]
      },
      "BUG_OR_PERFORMANCE": {
        "primary_domain": "engineering_method",
        "support_domains": ["context_intelligence", "scope_efficiency", "requirements"]
      },
      "REFACTOR": {
        "primary_domain": "engineering_method",
        "support_domains": ["context_intelligence", "scope_efficiency"]
      },
      "ARCHITECTURE": {
        "primary_domain": "engineering_method",
        "support_domains": ["requirements", "scope_efficiency", "context_intelligence"]
      },
      "CODE_REVIEW": {
        "primary_domain": "engineering_method",
        "support_domains": ["context_intelligence", "requirements"]
      }
    },
    "required_support_skills": [
      "engineering-discipline"
    ],
    "optional_context_skills": [
      "code-review-graph"
    ],
    "max_support_skills_loaded": 2,
    "graph_unavailable_policy": "continue_with_direct_repository_search",
    "forbidden_production_skills": [
      "blockbench-production",
      "blockbench-geometry",
      "blockbench-texture",
      "blockbench-animation",
      "blockbench-validation"
    ],
    "load_only_when_required": [
      "mcp-builder",
      "typescript-expert",
      "zod",
      "openspec-*",
      "engineering-discipline",
      "code-review-graph"
    ]
  },
  "deprecated_skill_names": [
    "blockbench-use",
    "blockbench-modeling",
    "blockbench-texturing"
  ]
}
