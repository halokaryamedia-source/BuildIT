{
  "schema_version": "1.3",
  "connection_id": "blockbench",
  "transport": "streamable_http",
  "canonical_url": "http://localhost:3000/bb-mcp",
  "strict_endpoint": true,
  "allow_port_scan": false,
  "codex": {
    "server_key": "blockbench",
    "config_env": "CODEX_HOME",
    "default_config_path": "~/.codex/config.toml",
    "config_section": "mcp_servers.blockbench",
    "restart_required_after_config_change": true
  },
  "blockbench": {
    "process_name": "Blockbench",
    "plugin_id": "mcp",
    "package_root": "mcp-blockbench",
    "plugin_output": "mcp-blockbench/dist/mcp.js",
    "source_package_version": "1.6.0",
    "required_settings": {
      "mcp_port": 3000,
      "mcp_auto_port": false,
      "mcp_endpoint": "/bb-mcp",
      "mcp_session_timeout_minutes": 30,
      "mcp_sse_heartbeat_seconds": 15
    },
    "single_active_instance": true,
    "single_active_write_session": true
  },
  "workspace": {
    "index": "workspace/workspace.json",
    "active_project": "workspace/active/<asset>/",
    "blockbench_files": "workspace/active/<asset>/blockbench/",
    "mcp_files": "workspace/active/<asset>/mcp/"
  },
  "required_common_tools": [
    "get_runtime_status",
    "get_project_info",
    "get_tool_profile",
    "activate_tool_profile",
    "manage_project_write_lease",
    "save_project_checkpoint",
    "capture_standard_views"
  ],
  "profile_specific_tools": {
    "BEDROCK_CUBOID_GEOMETRY": ["validate_reference_contract", "complete_stage"],
    "BEDROCK_CUBOID_TEXTURE": ["validate_reference_contract", "save_texture_evidence", "complete_stage"],
    "BEDROCK_CUBOID_ANIMATION": ["validate_reference_contract", "complete_stage"],
    "FINAL_VALIDATION_READONLY": ["validate_reference_contract", "save_texture_evidence", "complete_stage"]
  },
  "tool_profile_contract": "engines/shared/profiles/tool-profiles.json",
  "default_tool_profile": "BEDROCK_CUBOID_GEOMETRY",
  "readiness_report": "workspace/active/<asset>/mcp/reports/connection.json"
}
