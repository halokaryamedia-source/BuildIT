{
  "schema_version": "1.4",
  "connection_id": "blockbench",
  "transport": "streamable_http",
  "canonical_url": "http://localhost:3000/bb-mcp",
  "strict_endpoint": true,
  "allow_port_scan": false,
  "codex": {
    "server_key": "blockbench",
    "config_env": "CODEX_HOME",
    "default_config_path": "~/.codex/config.toml",
    "config_section": "mcp_servers.blockbench",
    "restart_required_after_config_change": true
  },
  "blockbench": {
    "process_name": "Blockbench",
    "plugin_id": "mcp",
    "package_root": "mcp-blockbench",
    "plugin_output": "mcp-blockbench/dist/mcp.js",
    "source_package_version": "1.7.0",
    "required_settings": {
      "mcp_port": 3000,
      "mcp_auto_port": false,
      "mcp_endpoint": "/bb-mcp",
      "mcp_session_timeout_minutes": 30,
      "mcp_sse_heartbeat_seconds": 15
    },
    "single_active_instance": true,
    "single_active_write_session": true
  },
  "workspace": {
    "index": "workspace/workspace.json",
    "active_project": "workspace/active/<asset>/",
    "blockbench_files": "workspace/active/<asset>/blockbench/",
    "mcp_files": "workspace/active/<asset>/mcp/",
    "bootstrap_source": "approved ChatGPT Reference Studio package",
    "bootstrap_tool": "create_project"
  },
  "normal_workflow": {
    "manual_workspace_setup_required": false,
    "manual_identity_sync_required": false,
    "manual_profile_activation_required": false,
    "manual_write_lease_required": false,
    "reconnect_required_after_stage_change": false,
    "registered_surface": "STABLE_PRODUCTION_UNION"
  },
  "required_common_tools": [
    "get_runtime_status",
    "get_project_info",
    "get_stage_context",
    "create_project"
  ],
  "profile_specific_tools": {
    "BEDROCK_CUBOID_GEOMETRY": [
      "inspect_reference_visual_preview",
      "analyze_geometry_views",
      "apply_cube_transforms",
      "submit_geometry_for_review"
    ],
    "BEDROCK_CUBOID_TEXTURE": [
      "create_texture",
      "save_texture_evidence",
      "submit_stage_for_review"
    ],
    "BEDROCK_CUBOID_ANIMATION": [
      "create_animation",
      "manage_keyframes",
      "submit_stage_for_review"
    ],
    "FINAL_VALIDATION_READONLY": [
      "validate_reference_contract",
      "export_model",
      "submit_stage_for_review",
      "complete_stage"
    ]
  },
  "diagnostic_only_tools": [
    "activate_tool_profile",
    "manage_project_write_lease",
    "rebind_active_project_identity"
  ],
  "tool_profile_contract": "engines/shared/profiles/tool-profiles.json",
  "default_tool_profile": "BEDROCK_CUBOID_GEOMETRY",
  "readiness_report": "workspace/active/<asset>/mcp/reports/connection.json"
}
