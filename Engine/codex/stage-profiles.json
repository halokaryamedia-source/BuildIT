{
  "schema_version": "2.1",
  "global": {
    "runtime_authority": "SavedData/sessions/<asset>/state.json",
    "governance": "Engine/codex/GOVERNANCE.md",
    "state_contract": "Engine/codex/STATE_MACHINE.md",
    "evidence_contract": "Engine/codex/EVIDENCE_CONTRACT.md",
    "checkpoint_contract": "Engine/codex/CHECKPOINT_RECOVERY.md",
    "tool_profile_contract": "Engine/codex/tool-profiles.json",
    "initial_build_mode": "bounded_batches",
    "revision_mode": "one_named_issue_or_tightly_related_pair",
    "accepted_area_policy": "immutable_unless_explicitly_reopened",
    "profile_transition_policy": "activate_then_reconnect_once"
  },
  "camera": {
    "front_axis_default": "-z",
    "projection": "orthographic",
    "views": [
      "front",
      "left_side",
      "back",
      "top_footprint",
      "front_left_3_4"
    ],
    "frame_margin_ratio": 1.25
  },
  "profiles": {
    "GEOMETRY": {
      "tool_profile_id": "BEDROCK_CUBOID_GEOMETRY",
      "repair_tool_profile_id": "GEOMETRY_LOCAL_REPAIR",
      "entry_states": ["REFERENCE_READY", "GEOMETRY_REVISION"],
      "working_state": "GEOMETRY_IN_PROGRESS",
      "review_state": "GEOMETRY_REVIEW",
      "approved_state": "GEOMETRY_APPROVED",
      "required_reference_files": [
        "reference_manifest.json",
        "PRODUCTION_CONTEXT.md",
        "<asset>_reference_visual.png",
        "GEOMETRY.md"
      ],
      "required_skill_profiles": ["blockbench-use", "blockbench-modeling"],
      "internal_passes": ["PRIMARY_FORM", "STRUCTURAL_DETAIL"],
      "review_gate": "GEOMETRY_REVIEW",
      "review_checkpoint": "checkpoints/10_geometry_review.bbmodel",
      "approved_checkpoint": "checkpoints/20_geometry_approved.bbmodel",
      "required_evidence": {
        "front": "evidence/geometry/geometry_front.png",
        "left_side": "evidence/geometry/geometry_left.png",
        "back": "evidence/geometry/geometry_back.png",
        "top_footprint": "evidence/geometry/geometry_top.png",
        "front_left_3_4": "evidence/geometry/geometry_front_left_3_4.png",
        "report": "evidence/geometry/geometry_report.json"
      },
      "revision_minimum_evidence": "affected views plus one depth or orthographic comparison view",
      "next_after_approval": "TEXTURE_IN_PROGRESS"
    },
    "TEXTURE": {
      "tool_profile_id": "BEDROCK_CUBOID_TEXTURE",
      "repair_tool_profile_id": "TEXTURE_LOCAL_REPAIR",
      "entry_states": ["GEOMETRY_APPROVED", "TEXTURE_REVISION"],
      "working_state": "TEXTURE_IN_PROGRESS",
      "review_state": "TEXTURE_REVIEW",
      "approved_state": "TEXTURE_APPROVED",
      "required_reference_files": [
        "reference_manifest.json",
        "PRODUCTION_CONTEXT.md",
        "<asset>_reference_visual.png",
        "GEOMETRY.md",
        "TEXTURING.md"
      ],
      "required_skill_profiles": ["blockbench-use", "blockbench-texturing"],
      "internal_passes": ["UV", "BASE_TEXTURE", "DETAIL_TEXTURE"],
      "review_gate": "TEXTURE_REVIEW",
      "review_checkpoint": "checkpoints/30_texture_review.bbmodel",
      "approved_checkpoint": "checkpoints/40_texture_approved.bbmodel",
      "required_evidence": {
        "atlas": "evidence/texture/texture_atlas.png",
        "front": "evidence/texture/texture_front.png",
        "left_side": "evidence/texture/texture_left.png",
        "back": "evidence/texture/texture_back.png",
        "front_left_3_4": "evidence/texture/texture_front_left_3_4.png",
        "report": "evidence/texture/texture_report.json"
      },
      "revision_minimum_evidence": "atlas plus affected model views",
      "next_after_approval": "ANIMATION_IN_PROGRESS_OR_SKIPPED"
    },
    "ANIMATION": {
      "tool_profile_id": "BEDROCK_CUBOID_ANIMATION",
      "repair_tool_profile_id": "ANIMATION_LOCAL_REPAIR",
      "entry_states": ["TEXTURE_APPROVED", "ANIMATION_REVISION"],
      "working_state": "ANIMATION_IN_PROGRESS",
      "review_state": "ANIMATION_REVIEW",
      "approved_state": "ANIMATION_APPROVED",
      "skipped_state": "ANIMATION_SKIPPED",
      "required_reference_files": [
        "reference_manifest.json",
        "PRODUCTION_CONTEXT.md",
        "<asset>_reference_visual.png",
        "GEOMETRY.md",
        "ANIMATION.md"
      ],
      "required_skill_profiles": ["blockbench-use", "blockbench-modeling"],
      "optional": true,
      "run_when": "manifest or ANIMATION.md lists at least one required animation family or interactive motion",
      "skip_when": "no required animation family or interactive motion is listed",
      "review_gate": "ANIMATION_REVIEW",
      "review_checkpoint": "checkpoints/50_animation_review.bbmodel",
      "approved_checkpoint": "checkpoints/60_animation_approved.bbmodel",
      "skipped_checkpoint": "checkpoints/60_animation_skipped.bbmodel",
      "required_evidence": {
        "hierarchy": "evidence/animation/animation_hierarchy.json",
        "pivots": "evidence/animation/animation_pivots.json",
        "neutral_pose": "evidence/animation/animation_neutral_pose.png",
        "clips": "evidence/animation/animation_<clip_name>.<preview_format>",
        "report": "evidence/animation/animation_report.json"
      },
      "next_after_approval_or_skip": "FINAL_VALIDATION"
    },
    "FINAL_VALIDATION": {
      "tool_profile_id": "FINAL_VALIDATION_READONLY",
      "entry_states": ["ANIMATION_APPROVED", "ANIMATION_SKIPPED", "FINAL_REVISION"],
      "working_state": "FINAL_VALIDATION",
      "review_state": "FINAL_REVIEW",
      "approved_state": "DONE",
      "required_reference_files": [
        "reference_manifest.json",
        "PRODUCTION_CONTEXT.md",
        "<asset>_reference_visual.png",
        "GEOMETRY.md",
        "TEXTURING.md",
        "ANIMATION.md",
        "VALIDATION.md"
      ],
      "required_skill_profiles": ["blockbench-use"],
      "automatic_local_fix_limit": 2,
      "review_gate": "FINAL_REVIEW",
      "candidate_checkpoint": "checkpoints/70_final_candidate.bbmodel",
      "pass_checkpoint": "checkpoints/80_validation_pass.bbmodel",
      "required_evidence": {
        "bbmodel": "final/<asset>.bbmodel",
        "textures": "final/textures/",
        "validation_report": "evidence/final/validation_report.json",
        "completed_validation": "evidence/final/completed_VALIDATION.md",
        "front": "evidence/final/final_front.png",
        "left_side": "evidence/final/final_left.png",
        "back": "evidence/final/final_back.png",
        "top_footprint": "evidence/final/final_top.png",
        "front_left_3_4": "evidence/final/final_front_left_3_4.png",
        "atlas": "evidence/final/final_texture_atlas.png"
      },
      "broad_failure_rule": "activate the relevant repair profile and return to the correct stage instead of silently fixing"
    }
  }
}
